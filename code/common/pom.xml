<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.trading</groupId>
    <artifactId>trading-platform</artifactId>
    <version>0.1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>common</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- P6-847: the parent's dependencyManagement already pins both to test scope;
         declaring it here makes that explicit and matches every sibling module. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Fluss client — compile scope since 2026-08-15: the DDL application
         contract tool (com.trading.common.schema.ddl.DdlApplyTool) lives in
         main and needs the client to parse/apply/inspect DDLs. The consumer
         services already carry fluss-client (ingestion declares it directly;
         compute via fluss-flink-2.2), so this does not change their runtime
         images. Also serves the integration-tagged CompatFluss* capability
         tests (real LOG/KV/changelog evidence against a live cluster).
         The 0.9.1-incubating client jar is a self-contained shaded artifact
         (its own pom declares runtime deps test-scoped), so the fat-jar
         builds are unaffected.
         P6-645: optional, so a future consumer of `common` opts in explicitly
         instead of silently inheriting the heavy client. Every module that imports
         org.apache.fluss already declares the client itself (verified across
         ingestion, compute, execution-gateway — and this module declares it for its
         own DdlApplyTool), so nothing resolves it transitively today. -->
    <dependency>
      <groupId>org.apache.fluss</groupId>
      <artifactId>fluss-client</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
