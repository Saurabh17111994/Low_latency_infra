# images.published.env — the seven project-built images as published, by digest.
# source-commit: 6b0afdafd465 (run 35604569244)
#
# Written by .github/workflows/publish-images.yml (decision D2 and Phase 1 of
# docs/plans/2026-09-21-ci-publish-and-single-node-rollout.md). Never hand-edit:
# after each publish the workflow resolves every value from the registry with
# code/01_platform/04_scripts/image-publish.sh.
#
# The deploy environment is rendered from this file rather than copied by hand:
#
#   bash code/01_platform/04_scripts/image-publish.sh \
#     --merge-env <your git-ignored deploy env> < code/01_platform/01_docker/images.published.env
#
# That rewrites the seven VAR=ref lines in place and preserves every unrelated
# line, so a deploy env never carries a bare tag (the stack steps and
# `make pin-check` both refuse those).
#
# No secret appears here: public package names and digests only.
# Format: VAR=registry/name:tag@sha256:...
#
# Empty until the first successful publish — an image that was never pushed has
# no manifest digest, and inventing one is what CHG-218 retired.
FLINK_IMAGE=ghcr.io/saurabh17111994/trading-flink-runtime:prod@sha256:a8dd8862cf0a9438e510deabd3c5c368fcf44e29a7d8e193fe1db91e2983e1c8
FLUSS_IMAGE=ghcr.io/saurabh17111994/trading-fluss-runtime:prod@sha256:b1cefba99a73b3c6beb76b0e6767b2a0d8d34a716d622276542a16f6abd6c38f
INGESTION_IMAGE=ghcr.io/saurabh17111994/01_docker-ingestion:prod@sha256:60c100e75fbd733ecb16e8c7f1ba46d31a424a574acf92acba2e62fba0836ac8
NAUTILUS_IMAGE=ghcr.io/saurabh17111994/01_docker-nautilus:prod@sha256:387b795f5a20fd5ad72a206f900c35e37085fa5a562b577b905ef063ac2e5283
EXECUTION_BRIDGE_IMAGE=ghcr.io/saurabh17111994/01_docker-execution-bridge:prod@sha256:f0871cdfe3365ab38959eba95b45d76235ffd8d4e94683a77a575ca761c29c4a
EXECUTION_GATEWAY_IMAGE=ghcr.io/saurabh17111994/01_docker-execution-gateway:prod@sha256:0289b07b2cb65f60c55bcf9b30bd27e892eb3a8749ce890d032fbc1cb0bea646
DDL_APPLY_IMAGE=ghcr.io/saurabh17111994/01_docker-ddl-apply:prod@sha256:706430c5990c8917a2f6a36ae78ba8e8884cbaccc052e4fc44afad8d5f71666f
