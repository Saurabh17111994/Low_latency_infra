# images.published.env — the seven project-built images as published, by digest.
# source-commit: e3ab030c592f (run 35567002862)
#
# Written by .github/workflows/publish-images.yml (decision D2 and Phase 1 of
# docs/plans/2026-09-21-ci-publish-and-single-node-rollout.md). Never hand-edit:
# after each publish the workflow resolves every value from the registry with
# code/01_platform/04_scripts/image-publish.sh.
#
# The deploy environment is rendered from this file rather than copied by hand:
#
#   bash code/01_platform/04_scripts/image-publish.sh \
#     --merge-env <your git-ignored deploy env> < code/01_platform/01_docker/images.published.env
#
# That rewrites the seven VAR=ref lines in place and preserves every unrelated
# line, so a deploy env never carries a bare tag (the stack steps and
# `make pin-check` both refuse those).
#
# No secret appears here: public package names and digests only.
# Format: VAR=registry/name:tag@sha256:...
#
# Empty until the first successful publish — an image that was never pushed has
# no manifest digest, and inventing one is what CHG-218 retired.
FLINK_IMAGE=ghcr.io/saurabh17111994/trading-flink-runtime:prod@sha256:a4fcb082170267c1edc45f756ea05ec1190fc090e98b9bea66342e7ee5dcef4b
FLUSS_IMAGE=ghcr.io/saurabh17111994/trading-fluss-runtime:prod@sha256:473e766d762305aa6ba13f65f8936492ffad5f1f5d0d8c9dc0cf5e485bc9658f
INGESTION_IMAGE=ghcr.io/saurabh17111994/01_docker-ingestion:prod@sha256:bf4acf9669b76c53047e8e960fe03a6642e450f1818d954105e19e8888c71492
NAUTILUS_IMAGE=ghcr.io/saurabh17111994/01_docker-nautilus:prod@sha256:7b8128bb9bfda75bb356d6cf1b50da9239d88d62223929f99d410a0c906dcb41
EXECUTION_BRIDGE_IMAGE=ghcr.io/saurabh17111994/01_docker-execution-bridge:prod@sha256:0da33b11359832fd757cda0af90f6253195873b8257d5524d230ada07108b4f5
EXECUTION_GATEWAY_IMAGE=ghcr.io/saurabh17111994/01_docker-execution-gateway:prod@sha256:317396d896353ebdee08e39858dda16a41271956aac6d0c69b920b3306cf42a4
DDL_APPLY_IMAGE=ghcr.io/saurabh17111994/01_docker-ddl-apply:prod@sha256:6457d6de312fd60bbdce470299ee5f553f7c51036217e1b1290f4678e7236425
