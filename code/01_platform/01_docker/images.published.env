# images.published.env — the seven project-built images as published, by digest.
# source-commit: 246b6edb3f44 (run 35636450951)
#
# Written by .github/workflows/publish-images.yml (decision D2 and Phase 1 of
# docs/plans/2026-09-21-ci-publish-and-single-node-rollout.md). Never hand-edit:
# after each publish the workflow resolves every value from the registry with
# code/01_platform/04_scripts/image-publish.sh.
#
# The deploy environment is rendered from this file rather than copied by hand:
#
#   bash code/01_platform/04_scripts/image-publish.sh \
#     --merge-env <your git-ignored deploy env> < code/01_platform/01_docker/images.published.env
#
# That rewrites the seven VAR=ref lines in place and preserves every unrelated
# line, so a deploy env never carries a bare tag (the stack steps and
# `make pin-check` both refuse those).
#
# No secret appears here: public package names and digests only.
# Format: VAR=registry/name:tag@sha256:...
#
# Empty until the first successful publish — an image that was never pushed has
# no manifest digest, and inventing one is what CHG-218 retired.
FLINK_IMAGE=ghcr.io/saurabh17111994/trading-flink-runtime:prod@sha256:93c16b9c0b41aaee73abe2052b81cb920b44dbd094579b1d5fa5c0bcaa15de76
FLUSS_IMAGE=ghcr.io/saurabh17111994/trading-fluss-runtime:prod@sha256:d79be4910c57a03e5bfd61029d89e7551ce295174c9fea23497104c877af7071
INGESTION_IMAGE=ghcr.io/saurabh17111994/01_docker-ingestion:prod@sha256:0bf6e3ca7d476cae5a22ff4ac002cb7197d32d1979a52c59a859a4b9afa42ac7
NAUTILUS_IMAGE=ghcr.io/saurabh17111994/01_docker-nautilus:prod@sha256:019274ae475c7fca744145e09bdd9e6338992785dd0982d813afe115c7747f53
EXECUTION_BRIDGE_IMAGE=ghcr.io/saurabh17111994/01_docker-execution-bridge:prod@sha256:12549f3466f59214cb3527ad6a8ecdce3cfab071d4121c01d282db87e322bfb5
EXECUTION_GATEWAY_IMAGE=ghcr.io/saurabh17111994/01_docker-execution-gateway:prod@sha256:1ff8274a12a6ed1acd91f3a53d48aa79859459f3cc484e37b40dca1699353641
DDL_APPLY_IMAGE=ghcr.io/saurabh17111994/01_docker-ddl-apply:prod@sha256:11274b3005386e9a9ebd7757e173843539c27c424f1ea25d72bb332335863335
