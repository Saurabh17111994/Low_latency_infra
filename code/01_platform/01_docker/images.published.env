# images.published.env — the seven project-built images as published, by digest.
# source-commit: de279e71e1a6 (run 35587874482)
#
# Written by .github/workflows/publish-images.yml (decision D2 and Phase 1 of
# docs/plans/2026-09-21-ci-publish-and-single-node-rollout.md). Never hand-edit:
# after each publish the workflow resolves every value from the registry with
# code/01_platform/04_scripts/image-publish.sh.
#
# The deploy environment is rendered from this file rather than copied by hand:
#
#   bash code/01_platform/04_scripts/image-publish.sh \
#     --merge-env <your git-ignored deploy env> < code/01_platform/01_docker/images.published.env
#
# That rewrites the seven VAR=ref lines in place and preserves every unrelated
# line, so a deploy env never carries a bare tag (the stack steps and
# `make pin-check` both refuse those).
#
# No secret appears here: public package names and digests only.
# Format: VAR=registry/name:tag@sha256:...
#
# Empty until the first successful publish — an image that was never pushed has
# no manifest digest, and inventing one is what CHG-218 retired.
FLINK_IMAGE=ghcr.io/saurabh17111994/trading-flink-runtime:prod@sha256:4def2f99943d152f5a2bcaab1ff509508b971b75ee6dd2a9c54b7b1e12766378
FLUSS_IMAGE=ghcr.io/saurabh17111994/trading-fluss-runtime:prod@sha256:28393f311b8baeb43851c4cf801fd5d00a53b0fa75139c24c75d868ee7ad601d
INGESTION_IMAGE=ghcr.io/saurabh17111994/01_docker-ingestion:prod@sha256:42d49588b023e20b1d8550c80a6cddb46481e9f1a64186cdfbfe0c54aa831195
NAUTILUS_IMAGE=ghcr.io/saurabh17111994/01_docker-nautilus:prod@sha256:99861b70c02348a0e47fe1a2e26ac0166c0d01ba96ea7819d8fa18a09a72d7af
EXECUTION_BRIDGE_IMAGE=ghcr.io/saurabh17111994/01_docker-execution-bridge:prod@sha256:3401de3b1ab6b1dbb1b92c1c768b1601f74ade851d99e202cd883cd8855364e1
EXECUTION_GATEWAY_IMAGE=ghcr.io/saurabh17111994/01_docker-execution-gateway:prod@sha256:9452c94dc9388c5e1dd71c630ef12080c59f6111aea20cb61a5a3f3fae766665
DDL_APPLY_IMAGE=ghcr.io/saurabh17111994/01_docker-ddl-apply:prod@sha256:33e36d49eaf841289514e067ef613f438be1a3c7b5f473634260fb557dd5ca62
