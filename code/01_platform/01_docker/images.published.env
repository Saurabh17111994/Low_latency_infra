# images.published.env — the seven project-built images as published, by digest.
# source-commit: 2e7993ec5566 (run 35875331208)
#
# Written by .github/workflows/publish-images.yml (decision D2 and Phase 1 of
# docs/plans/2026-09-21-ci-publish-and-single-node-rollout.md). Never hand-edit:
# after each publish the workflow resolves every value from the registry with
# code/01_platform/04_scripts/image-publish.sh.
#
# The deploy environment is rendered from this file rather than copied by hand:
#
#   bash code/01_platform/04_scripts/image-publish.sh \
#     --merge-env <your git-ignored deploy env> < code/01_platform/01_docker/images.published.env
#
# That rewrites the seven VAR=ref lines in place and preserves every unrelated
# line, so a deploy env never carries a bare tag (the stack steps and
# `make pin-check` both refuse those).
#
# No secret appears here: public package names and digests only.
# Format: VAR=registry/name:tag@sha256:...
#
# Empty until the first successful publish — an image that was never pushed has
# no manifest digest, and inventing one is what CHG-218 retired.
FLINK_IMAGE=ghcr.io/saurabh17111994/trading-flink-runtime:prod@sha256:70b04617bea29ea927d4e4daec4366854af7ed497a6a14ca2fa08bfd487d96b3
FLUSS_IMAGE=ghcr.io/saurabh17111994/trading-fluss-runtime:prod@sha256:e1bf98e6c58514641f1baa75c9f62534c64b7eb2e811a53b333c1ca007d52645
INGESTION_IMAGE=ghcr.io/saurabh17111994/01_docker-ingestion:prod@sha256:9cdd490935b98b1bd3dc06d495a964691eba27f235680b072bd28000b49517c3
NAUTILUS_IMAGE=ghcr.io/saurabh17111994/01_docker-nautilus:prod@sha256:198bcfd4f306644813263ae83d99885bfa6c4cfc055e4575cb8718440c8e28ca
EXECUTION_BRIDGE_IMAGE=ghcr.io/saurabh17111994/01_docker-execution-bridge:prod@sha256:4d0b65a7860e69e1e1abda16890317f9b970b9ce64675b75ba8b15c09e3f1fe8
EXECUTION_GATEWAY_IMAGE=ghcr.io/saurabh17111994/01_docker-execution-gateway:prod@sha256:a6ff2bea186a089f73505dc5d7a64f48c705613dd973bb2604103678c0eb7431
DDL_APPLY_IMAGE=ghcr.io/saurabh17111994/01_docker-ddl-apply:prod@sha256:3102c5b8c72eee4b4adaa72e26fbb4656237b3366cf0cdd518ad48306b453069
