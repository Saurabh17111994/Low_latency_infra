# Copy this file to .env and fill in real values. NEVER commit .env.
# `make env` does this copy for you.
#
# VERSIONS: aligned to the pinned version matrix (DEC-021, project memory #17).
#   Fluss: 0.9.1-incubating | Flink: 2.2.1 | Java: 17.0.19 | Python: 3.11.9
#   OpenObserve: v0.91.5-amd64 (public.ecr.aws/zinclabs/openobserve)
#
# LOCAL-ONLY: Tags below are for Compose development. Production SHALL use
# immutable digests pinned in runtime.lock. Example production format:
#   FLUSS_IMAGE=apache/fluss:0.9.1-incubating@sha256:abc123...
#   FLINK_IMAGE=flink:2.2.1-scala_2.12-java17@sha256:def456...
#   OPENOBSERVE_IMAGE=public.ecr.aws/zinclabs/openobserve:v0.91.5-amd64@sha256:ghi789...

# ---- Fluss / Flink / OpenObserve image references --------------------------
FLUSS_IMAGE=apache/fluss:0.9.1-incubating
FLINK_IMAGE=flink:2.2.1-scala_2.12-java17
OPENOBSERVE_IMAGE=public.ecr.aws/zinclabs/openobserve:v0.91.5-amd64

# ---- SignalJob recovery + safety (P2-079) --------------------------------
# STATE_RECOVERY_PATH rides the flink-common anchor so the JOB JVM (JM/TM),
# not just the compute launcher, sees it — SignalJob's [F005] gate reads it
# via System.getenv. Unset = clean LATEST start (dev) or fail-closed (prod).
STATE_RECOVERY_PATH=
# SAFETY_MANIFEST_TOKENS: comma-separated instrument tokens for SafetyHaltJob.
# Empty in dev skips the safety consumer; production MUST set it (fail-closed).
SAFETY_MANIFEST_TOKENS=

# ---- Fluss cluster (lake tiering needs S3) ---------------------------------
FLUSS_BOOTSTRAP=fluss-coordinator:9123
# Signal job alias (compose/Swarm Fluss wiring): FLUSS_BOOTSTRAP_SERVERS is the
# SignalJobConfig contract; FLUSS_BOOTSTRAP is the compose/stack alias that
# resolves via DNS. Setting SERVERS keeps `docker compose config` explicit
# and avoids the localhost:9123 fallback inside Flink containers.
FLUSS_BOOTSTRAP_SERVERS=fluss-coordinator:9123
FLUSS_DATABASE=default
# Position_State handshake (Option B max-one-active, DDL 29_position_state.sql):
# KV per-instrument lifecycle (instrument_token PK, 16 buckets, 7d log TTL).
# Defaults to Position_State so DDL drift is visible at compose/stack config time.
POSITION_STATE_TABLE=Position_State
# datalake.* cluster-level defaults (must match DDL table.datalake.format)
DATALAKE_FORMAT=iceberg
# AWS S3 (Iceberg lake) — use instance role or creds below — .env.example MUST NOT embed production secrets (t8_sandbox_contract_check C15)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_WAREHOUSE_PATH=s3://fluss-warehouse
# Cloudflare R2 (S3-compatible lake tier, P3.2): endpoint is required with
# access/secret keys (R2 API tokens) — the coordinator/tablet fail closed at
# `docker compose up` if any of S3_WAREHOUSE_PATH/R2_ENDPOINT/creds is unset
# while lake tiering is enabled.
R2_ENDPOINT=http://minio:9000
R2_BUCKET=fluss-warehouse
# ---- Arrow Trade — market data ingestion (Go arrow-bridge + Java) ------
# The Go arrow-bridge uses the official Arrow Go SDK for auth, WebSocket,
# and binary frame decode. Java reads NDJSON from stdin → Fluss.
#
# Auth: TOTP only (ARROW_TOKEN removed 2026-08-24) — use
# ARROW_APP_SECRET + ARROW_USER_ID + ARROW_PASSWORD + ARROW_TOTP_KEY (AutoLogin)
ARROW_APP_ID=
ARROW_APP_SECRET=
# ARROW_TOKEN removed — do not set (TOTP only)
# AutoLogin credentials (required — TOTP only, ARROW_TOKEN removed 2026-08-24):
ARROW_USER_ID=
ARROW_PASSWORD=
ARROW_TOTP_KEY=
# HFT feed settings:
ARROW_HFT_LATENCY_MS=50          # tick interval 50-60000ms
# T0 3-slot (streaming-3000): env-driven slot count N=1..3 (default 1 = 1024).
# For 3000 set ARROW_HFT_CONNECTIONS=3 — a single 3000-row CSV auto-shards
# 1024+1024+952 via BuildSubscriptionPlan. Go/Java both enforce 1..3.
ARROW_HFT_CONNECTIONS=1
# Optional host/container manifest path overrides (compose mounts via x-manifest anchors):
# INSTRUMENT_MANIFEST_HOST_PATH=/host/path/to/NSE_CM_EQUITY (1024).csv
# INSTRUMENT_MANIFESTS_HOST_DIR=/host/path/to/cash_stocks
# INSTRUMENT_MANIFEST_PATH=/instruments/NSE_CM_EQUITY.csv
# ARROW_INSTRUMENT_MANIFEST=/instruments/NSE_CM_EQUITY.csv
ARROW_INSTRUMENT_TOKENS=         # comma-separated; production requires manifest-derived tokens
# Timestamp-freshness evidence gates (plan B3). User-approved production values
# (2026-08-01); override only if feed-latency measurements change them.
ARROW_MAX_EVENT_AGE_MS=5000
ARROW_MAX_FUTURE_EVENT_SKEW_MS=2000
# Clock offset limit in ms (default 2000 / 2s, T10). Dev host measured -102ms on one
# sample (2026-08-14); 2000 leaves margin while still catching genuine drift.
CLOCK_OFFSET_LIMIT_MS=2000
READINESS_FILE_PATH=/tmp/ingestion.ready
# T2 tunable backpressure (G2 Ingest) — streaming-3000: 50k/64M (1k) → 150k/192M (3k)
# Bounded halt: tunable queue, env overrides, 80% warn / 100% halt (fail-closed, never silent drop).
# Primary: MAX_PENDING_APPEND_RECORDS / MAX_PENDING_APPEND_BYTES / PENDING_APPEND_WARNING_PERCENT.
# Aliases: PENDING_MAX_RECORDS / PENDING_MAX_BYTES / PENDING_WARNING_PERCENT (primary wins if both set).
# For 3k: 150000 / 201326592 (192MiB). For 1k dev: override to 50000 / 67108864 (64MiB) via .env.
# Keep halt logic — halt is pinned until restart (ING-FAIL-005). Thresholds below.
# Example for 3k (default):
MAX_PENDING_APPEND_RECORDS=150000
MAX_PENDING_APPEND_BYTES=201326592
PENDING_APPEND_WARNING_PERCENT=0.80
# Aliases (optional) — task-spec ergonomics (T2). If PENDING_MAX_* set and primary not set, alias is used.
# PENDING_MAX_RECORDS=150000
# PENDING_MAX_BYTES=201326592
# PENDING_WARNING_PERCENT=0.80

# ---- Arrow Trade — order updates postback ----------------------------------
# JSON WebSocket endpoint for order-lifecycle updates
ARROW_ORDER_UPDATES_URL=wss://order-updates.arrow.trade
# ARROW_APP_ID reused from above (ARROW_TOKEN removed)

# ---- Arrow Trade — order execution REST API ---------------------------------
# REST endpoint for order submission: POST /order/regular
ARROW_REST_URL=https://edge.arrow.trade
# ARROW_APP_ID reused from above (ARROW_TOKEN removed)

# ---- Execution safety — MUST be false in .env.example -----------------------
# Set to true ONLY after gate, fencing, reconciliation, and crash-window
# acceptance tests pass in the target production environment.
EXECUTION_ENABLED=false

# ---- OpenObserve -----------------------------------------------------------
O2_USER=admin@example.com
O2_PASSWORD=
# Base64-encoded "${O2_USER}:${O2_PASSWORD}" for the OTel Collector auth header.
# Generate with: echo -n "admin@example.com:<password>" | base64 — .env.example MUST NOT embed a production password (CHG- example)
O2_AUTH_BASIC=
# OTLP collector endpoint for the javaagent/SDK (OTLP/HTTP -> :4318). :4317
# is gRPC-only; pointing the agent at it breaks every export (live-proven 2026-09-07).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
