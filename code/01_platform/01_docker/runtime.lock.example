# Runtime lock — pinned semantic versions for the streaming trading platform.
#
# Purpose: every container image, library, and runtime version that affects
# reproducible behavior is pinned here. This file is the single source of truth
# for version compatibility. No "latest", no ranges.
#
# Usage: copy to runtime.lock and fill image digests when they are available.
# Never commit digests you cannot verify from the upstream registry.
#
# VERSIONS: aligned to the pinned version matrix (DEC-021, project memory #17).
#   Fluss: 0.9.1-incubating | Flink: 2.2.1 | Java: 17.0.19 | Python: 3.11.9
#   OpenObserve: v0.91.5-amd64 (public.ecr.aws/zinclabs/openobserve)
#
# Last updated: 2026-07-24 (pinned matrix aligned)

# ---- Container image versions (semantic tags; fill digests before production) ----
FLUSS_IMAGE=apache/fluss:0.9.1-incubating
FLINK_IMAGE=flink:2.2.1-scala_2.12-java17
OPENOBSERVE_IMAGE=public.ecr.aws/zinclabs/openobserve:v0.91.5-amd64
# INGESTION_IMAGE=  # built from code/02_services/01_ingestion — pin digest
# COMPUTE_IMAGE=  # built from code/02_services/02_compute — pin digest
# EXECUTOR_IMAGE=  # built from code/02_services/04_executor — pin digest

# ---- Library and runtime versions (from code/pom.xml dependency management) ----
FLINK_VERSION=2.2.1
FLUSS_VERSION=0.9.1-incubating
JAVA_VERSION=17.0.19
SCALA_BINARY_VERSION=2.12

# ---- Fluss-Flink connector ----
# Fluss 0.9.1-incubating ships connectors matching Flink minor: fluss-flink-2.2
FLUSS_FLINK_CONNECTOR=fluss-flink-2.2

# ---- Arrow Trade protocol evidence ----
# Market-data: binary WebSocket, 4 modes (LTP 13B, LTPC 17B, Quote 93B, Full 241B)
# Order execution: REST POST /order/regular on https://edge.arrow.trade
# Order updates: JSON WebSocket on wss://order-updates.arrow.trade
# Reconciliation: GET /user/orders, /user/trades, /user/positions, /order/{id}
# Auth (2026-08-24+): TOTP AutoLogin — ARROW_APP_ID + ARROW_APP_SECRET +
#   ARROW_USER_ID + ARROW_PASSWORD + ARROW_TOTP_KEY (client.AutoLogin).
#   ARROW_TOKEN is REMOVED (dead since 2026-08-24); only the faketool test
#   broker path (run-full-suite.sh, ARROW_FAKE_BROKER=1) sets a fake token.
# SDK: github.com/arrow-trade/go-arrow
# Rate limit: 10 req/sec per endpoint

# ---- Required env vars (values from .env; listed here for completeness) ----
# ARROW_MARKET_DATA_URL, ARROW_ORDER_UPDATES_URL, ARROW_REST_URL
# ARROW_APP_ID, ARROW_APP_SECRET, ARROW_USER_ID, ARROW_PASSWORD, ARROW_TOTP_KEY
# EXECUTION_ENABLED (must be false)
# AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_WAREHOUSE_PATH
# O2_USER, O2_PASSWORD
# OTEL_EXPORTER_OTLP_ENDPOINT
