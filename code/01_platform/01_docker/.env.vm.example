# ---- Ephemeral-VM profile (daily CloudPe VM) --------------------------------
# Copy to `.env.vm` (same directory, gitignored) on the VM. The daily runner
# loads it at start (`day_run.load_vm_env`), and the `trading-eod` systemd unit
# reads it as its EnvironmentFile. Shell values always win: `ALLOW_FRESH=0 make
# day ...` overrides anything here. The dev PC has no `.env.vm`, so none of this
# applies there — its start/stop behaviour is unchanged.
#
# Build steps and the daily flow: docs/05_deployment/CLOUDPE_DAILY_VM.md

# H4-2: the daily VM's operating mode is a decision, not an accidental default.
# DEPLOYMENT_ENV=dev + UNIVERSE=full runs the real 2433-instrument NSE cash
# universe over the three approved dev sockets (multi-connection approved).
# Production posture is refused here on purpose: day_run.resolve_universe refuses
# `full` under DEPLOYMENT_ENV=prod/production (CHG-320) — this host's job is the
# full dev universe, and that refusal stays.
DEPLOYMENT_ENV=dev
UNIVERSE=full

# A fresh disk every morning has no savepoint/checkpoint; allow the fresh start
# without a flag. It can never skip a restore: savepoint and checkpoint are
# tried first (day_run.decide_signaljob).
ALLOW_FRESH=1

# M4-1 (SCH-22): the daily VM reads the real feed — refuse a truncated CSV
# below the approved-universe minimum (the full NSE cash universe is 2433
# rows; the approved manifest is 1024). day_run.py also pins this in the
# effective `make up` environment.
INSTRUMENT_MANIFEST_MIN_COUNT=1024

# Dual-channel selector (2026-09-29): the daily VM reads the live DataStream
# channel (`token`); HFT is one edit away (`ARROW_FEED=hft`). Both feeds share
# the same slot supervisor, proto transport and Java admission path — only the
# ingestion edge differs. day_run.py also pins this in the effective `make up`
# environment, so a stale `.env.vm` cannot silently fall back to the dead HFT
# plan.
ARROW_FEED=token

# `make day ARGS="stop"` refuses until today's EOD archive is confirmed — the
# VM disk dies with the stack, so stop is the last chance to keep the day.
# Override deliberately, and only with a reason: DAY_STOP_FORCE=1.
DAY_STOP_REQUIRE_EOD=1

# EOD -> R2 after the Indian market close. 15:45 IST gives the day 15 minutes
# to settle after 15:30. The scheduler runs in the trading-eod systemd unit.
EOD_AT=15:45
EOD_ZONE=Asia/Kolkata
# Tables the EOD manifest covers — an operator decision (the tool is
# fail-closed without it); candle_closed is the durable record.
EOD_TABLES=candle_closed
EOD_OFFLOAD=lake
# C3-3: run the controller inside its existing compose service. A fresh golden
# VM has no host JDK and no m2 repo, so host mode cannot work there; the unit
# shells the one-shot `docker compose ... run --rm -T eod-controller` instead
# (the image carries both). The stack file defaults to the repo's
# docker-compose.yml; set EOD_COMPOSE_FILE if the layout ever differs.
EOD_RUNNER=compose
# Where the scheduler records its last clean run; the stop gate compares the
# stamp against today in the trading zone.
EOD_LAST_RUN_FILE=/var/lib/trading/eod-last-run
