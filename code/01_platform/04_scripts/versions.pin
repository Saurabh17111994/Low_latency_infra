# Version pins for the DDL application contract.
#
# Platform versions (Flink/Fluss) are PINNED (Option A, approved 2026).
# BROKER_PROTOCOL (go-arrow) is PINNED (see line 18). Remaining
# external/verification versions (Arrow API contract, schema lifecycle)
# stay TO_BE_VERIFIED until their contracts are captured and capability
# tests run.
#
# `make ddl` enforces the VERSION GATE on PLATFORM versions only
# (FLINK_VERSION, FLUSS_VERSION): absent / 'latest' / placeholder -> FAIL.
# DDL application requires capability evidence (project rule: no DDL apply
# until pinned compatibility + schema lifecycle tests pass). The historical
# reconciliation blocker was removed 2026-08-15.
#
# See docs/08_implementation/01-foundation.md -> "Placeholder policy" (orig L178)
# and docs/08_implementation/12-version-compatibility-evidence.md.

FLINK_VERSION=2.2.1
FLUSS_VERSION=0.9.1-incubating
ZOOKEEPER_VERSION=3.9.2
# Python runtime pin (VM-PYTHON-002). The ddl-apply image must ship this exact
# series — enforced by `ddl-apply version` (ddl-apply-run.sh). The 2026-08-24
# image drifted to 3.14.4 (apt default on the temurin base); the image now
# installs python3.11 explicitly to match. Host tooling may run a newer 3.11.x.
PYTHON_VERSION=3.11.9
BROKER_PROTOCOL=go-arrow-v0.2.0 (module:github.com/arrow-trade/go-arrow, upstream tag v0.2.0 merge 1390d40/tag-commit 67bc0b0 = base 7cce1630 + Wave9 A-D,F,G, in-repo patches R-101..R-243 merged d935e14, vendored third_party/go-arrow replace, tree sha256:1ea24cd66aed0d020c5b4cb3e97082aafba511a670c53925c00a46cae6ddf460) PINNED
ARROW_API_CONTRACT=v2026-05 (captured from Arrow_broker repo, docs/04_contracts/arrow_broker.md)
SCHEMA_LIFECYCLE=v1 (all 6 schema-state classes + 5 evolution classes implemented)

# Nautilus execution-service audit pin. The commit is reproducible but remains
# deployment-blocked until the locked Rust service/API capability evidence is
# accepted; do not replace it with a floating develop branch.
NAUTILUS_COMMIT=74d57e7e055015a8d974a0cf047ac2e5139610b3
NAUTILUS_WORKSPACE_VERSION=0.62.0
NAUTILUS_RUST_TOOLCHAIN=1.97.1
EXECUTION_BRIDGE_GO_TOOLCHAIN=1.24.5
EXECUTION_BRIDGE_GO_IMAGE=golang:1.24.5-alpine@sha256:daae04ebad0c21149979cd8e9db38f565ecefd8547cf4a591240dc1972cf1399
EXECUTION_BRIDGE_SDK_TREE_SHA256=1ea24cd66aed0d020c5b4cb3e97082aafba511a670c53925c00a46cae6ddf460

