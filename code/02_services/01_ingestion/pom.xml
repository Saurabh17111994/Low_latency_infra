<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.trading</groupId>
    <artifactId>trading-platform</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>ingestion</artifactId>
  <packaging>jar</packaging>

  <!-- P1-213: protobuf/log4j versions hoisted to in-file properties (single
       edit point for this module). Moving them to parent dependencyManagement
       (matching the slf4j/jackson pattern) is out of scope for this batch —
       the parent currently standardizes on logback-classic, so that move
       needs a deliberate parent-level decision. NOTE: execution-gateway
       copy-pastes the 2.25.4 log4j triplet and additionally diverges by
       omitting log4j-api — keep the two modules' log4j versions in sync
       until centralization lands. -->
  <properties>
    <protobuf.version>3.25.5</protobuf.version>
    <log4j2.version>2.25.4</log4j2.version>
  </properties>

  <dependencies>
    <!-- slf4j-api declared FIRST so it precedes the Fluss client on the test
         classpath — the Fluss client bundles slf4j-api 1.7 classes inside its
         own jar, and if those win the classpath the 2.x ServiceLoader provider
         (log4j-slf4j2-impl) is never consulted and logging silently goes NOP.
         Version comes from the parent (slf4j 2.0.9). -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Apache Fluss Java client — version from parent -->
    <dependency>
      <groupId>org.apache.fluss</groupId>
      <artifactId>fluss-client</artifactId>
    </dependency>

    <!-- JSON parsing (stdin NDJSON) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Protobuf runtime (T1: market_data.proto transport contract) -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>

    <!-- Platform common types -->
    <dependency>
      <groupId>com.trading</groupId>
      <artifactId>common</artifactId>
    </dependency>

    <!-- Logging: SLF4J API 2.0.9 → Log4j2 2.25.4 via the SLF4J 2.x binding
         (log4j-slf4j2-impl). The 1.7 binding (log4j-slf4j-impl) does not
         implement the org.slf4j.spi.SLF4JServiceProvider SPI that SLF4J 2.x
         discovers, so logging would silently fall back to NOP — R-025. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <version>${log4j2.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j2.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>${log4j2.version}</version>
    </dependency>

    <!-- Zstd decompression moved to Go arrow-bridge (official Arrow SDK). -->

    <!-- OpenTelemetry API for 3 hand-placed batch-level spans (phase 2).
         Version 1.44.1 pairs with the v2.9.0 javaagent in the image (its
         SDK implements these exact 1.x interfaces; 1.x is backward-stable).
         API-only: no SDK/exporter bundled — with the agent present,
         GlobalOpenTelemetry resolves to the agent's SDK and spans export via
         the collector; without it (tests, bare JVM) every call is a no-op. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>1.44.1</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ingestion</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- P1-052: fluss-client bundles a full slf4j-api 1.7 copy
                   (org/slf4j/**, verified in fluss-client-0.9.1). Declaration
                   order only affects the test classpath — the shaded fat jar
                   needs a structural exclusion or 1.7 classes collide with
                   our 2.x API (NoSuchMethodError/LinkageError, not just NOP).
                   Kept minimal: filter only (no enforcer plugin — no new
                   build deps, nothing else duplicates today). -->
              <filters>
                <filter>
                  <artifact>org.apache.fluss:fluss-client</artifact>
                  <excludes>
                    <exclude>org/slf4j/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.trading.ingestion.IngestionService</mainClass>
                </transformer>
                <!-- R-060: merge META-INF/services provider files (Fluss client,
                     Arrow) instead of last-wins, so ServiceLoader-based
                     providers survive shading.
                     P1-053 correction: ServicesResourceTransformer does NOT
                     merge Log4j2's binary plugin cache (Log4j2Plugins.dat) —
                     the old comment claimed it did. The dedicated
                     Log4j2PluginsCacheFileTransformer is absent from the
                     pinned log4j-core 2.25.4 build (full .m2 scan), so adding
                     it breaks packaging. Safe today: only log4j-core
                     contributes a .dat (fluss-client ships none, verified).
                     Revisit if a second plugin contributor arrives. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
