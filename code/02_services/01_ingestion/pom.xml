<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.trading</groupId>
    <artifactId>trading-platform</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>ingestion</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <!-- slf4j-api declared FIRST so it precedes the Fluss client on the test
         classpath — the Fluss client bundles slf4j-api 1.7 classes inside its
         own jar, and if those win the classpath the 2.x ServiceLoader provider
         (log4j-slf4j2-impl) is never consulted and logging silently goes NOP.
         Version comes from the parent (slf4j 2.0.9). -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Apache Fluss Java client — version from parent -->
    <dependency>
      <groupId>org.apache.fluss</groupId>
      <artifactId>fluss-client</artifactId>
    </dependency>

    <!-- JSON parsing (stdin NDJSON) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Protobuf runtime (T1: market_data.proto transport contract) -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>3.25.5</version>
    </dependency>

    <!-- Platform common types -->
    <dependency>
      <groupId>com.trading</groupId>
      <artifactId>common</artifactId>
    </dependency>

    <!-- Logging: SLF4J API 2.0.9 → Log4j2 2.25.4 via the SLF4J 2.x binding
         (log4j-slf4j2-impl). The 1.7 binding (log4j-slf4j-impl) does not
         implement the org.slf4j.spi.SLF4JServiceProvider SPI that SLF4J 2.x
         discovers, so logging would silently fall back to NOP — R-025. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <version>2.25.4</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.25.4</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>2.25.4</version>
    </dependency>

    <!-- Zstd decompression moved to Go arrow-bridge (official Arrow SDK). -->

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ingestion</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.trading.ingestion.IngestionService</mainClass>
                </transformer>
                <!-- R-060: merge META-INF/services provider files (Fluss client,
                     Arrow) and Log4j2 plugin metadata instead of last-wins, so
                     ServiceLoader-based providers survive shading. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
