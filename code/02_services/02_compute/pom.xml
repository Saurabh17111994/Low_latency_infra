<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.trading</groupId>
    <artifactId>trading-platform</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>compute</artifactId>
  <packaging>jar</packaging>

  <properties>
    <!-- log4j2.version comes from the parent (P2-218 centralization). -->
    <!-- P2-112: argLine as a PROPERTY, not just plugin config — surefire's
         @{argLine} late replacement reads this property, so an injected
         agent (JaCoCo -javaagent) that prepends to it survives, and the
         placeholder is always defined (a bare @{argLine} with no property
         is passed to the JVM literally and breaks the fork). -->
    <argLine>--add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED</argLine>
  </properties>

  <dependencies>
    <!-- slf4j-api declared FIRST (ingestion R-025 pattern): on the test
         classpath the Fluss client's bundled slf4j-api 1.7 must not win over
         2.x — if it does, the log4j-slf4j2-impl ServiceLoader provider is
         never consulted and logging silently goes NOP. Version from parent. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-clients</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-api-java-bridge</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- fluss-flink-2.2 extends org.apache.flink.connector.base.source.reader.*;
         and flink-streaming-java does NOT pull flink-connector-base transitively
         (verified against the flink-streaming-java 2.2.1 pom). Provided: the
         Flink dist ships it in lib/. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-base</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- RowDataDeserializationSchema.getProducedType resolves to
         org.apache.flink.table.runtime.typeutils.InternalTypeInfo; the fluss
         connector does not declare flink-table-runtime, and the Flink dist
         ships it in lib/. Provided for the same reason as flink-connector-base. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-runtime</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Test harnesses (KeyedProcessFunctionTestHarness,
         OneInputStreamOperatorTestHarness, …) ship in the flink-streaming-java
         TEST jar, not the main artifact. Test scope only — never bundled. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- MiniClusterWithClientResource + test utilities for the
         STATE-COMPAT-001 / COMPAT-FLINK-001 rows of the resolution plan. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-test-utils</artifactId>
      <version>${flink.version}</version>
      <scope>test</scope>
      <exclusions>
        <!-- Both bridge jars define org.apache.logging.slf4j.Log4jLoggerFactory;
             the stale 2.24.3 copy (slf4j 1.x era) shadows 2.25.4's on the fork
             classpath and its context never reads target/test-classes/log4j2.xml
             (verified 2026-08-12: probe showed config "null" + TestLogger
             appender, zero log4j2 output). Keep only log4j-slf4j2-impl 2.25.4. -->
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j-impl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Embedded RocksDB backend (tracker 14 P4.3): proves the pinned production
         state backend restores dedup/window/sink state in the MiniCluster. Test
         scope only — the dist provides it at runtime. Pulls frocksdbjni
         (Ververica's rocksdbjni fork, 8.10.0-ververica-1.0) transitively. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-statebackend-rocksdb</artifactId>
      <version>${flink.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- S3 object-store filesystem (tracker 14 P4.2): the MiniCluster resolves
         s3:// checkpoint URIs against Cloudflare R2 via the SAME
         flink-s3-fs-hadoop the dist ships as a plugin. Self-contained shaded
         jar (bundles hadoop-aws 3.3.x + AWS SDK v1). Test scope only — the
         dist provides it at runtime. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-s3-fs-hadoop</artifactId>
      <version>${flink.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- slf4j 2.x provider for test logging: without it surefire falls back to
         NOP and MiniCluster failures (e.g. checkpoint-write errors in the P4.2
         proof) are silent. 2.25.4 is the only log4j-slf4j2-impl in .m2. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <version>${log4j2.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- P2-110: explicit log4j-api pin matching core/slf4j2-impl (parent has
         no log4j DM yet — transitivity would otherwise mediate the version). -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j2.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>${log4j2.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The Flink image supplies the Fluss connector and client in
         /opt/flink/lib.  Keeping this dependency compile-scoped made the
         shade plugin copy ~9,000 org.apache.fluss classes into compute.jar;
         that duplicated the interface used by Fluss' HDFS/S3 ServiceLoader
         providers and caused HdfsSecurityTokenReceiver "not a subtype" at
         source startup (C2, 2026-09-01).  Provided keeps the API available to
         javac/tests without shipping a second Fluss class universe. -->
    <dependency>
      <groupId>org.apache.fluss</groupId>
      <artifactId>fluss-flink-2.2</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- common has a compile-scoped fluss-client dependency for DdlApplyTool;
         override it here so shading common cannot reintroduce the duplicate
         client transitively. -->
    <dependency>
      <groupId>org.apache.fluss</groupId>
      <artifactId>fluss-client</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Native OpenTelemetry metric reporter (CHG-023 item 1, 2026-08-17):
         replaces the hand-rolled ComputeOtlpEmitter metric half. The 2.2.1
         artifact is a SHADED fat jar (the OTel SDK 1.30.1 + OTLP exporters are
         bundled inside — verified in flink-metrics-otel-2.2.1.jar, 984
         io/opentelemetry classes; the published pom declares no OTel deps).
         Delivery vehicle is the dist plugin dir ONLY: the jar must be under
         /opt/flink/plugins/ (see CHG-023 deployment note) for the TaskManager
         metric registry. It is NOT shaded into compute.jar (P2-109) — that
         duplicated the reporter + OTel SDK class universe. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-metrics-otel</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
      <!-- P2-109 (firm review choice): provided + /opt/flink/plugins/ only.
           Compile-scope shaded the reporter + the whole bundled OTel SDK
           (984 io/opentelemetry classes) into compute.jar, duplicating the
           plugin class universe (child-first vs job classloader, duplicated
           GlobalOpenTelemetry static state) and risking ClassCastException /
           double-reporting. Provided keeps it on the compile/test classpath
           (string-config + ServiceLoader tests still pass) without shipping
           a second OTel copy. -->
    </dependency>
    <dependency>
      <groupId>com.trading</groupId>
      <artifactId>common</artifactId>
    </dependency>
    <!-- P2-111: parent dependencyManagement already forces assertj-core to
         test scope (verified: dependency:tree shows :test, nothing shaded),
         but an explicit override here keeps that guarantee local — a future
         parent-DM cleanup must not silently re-inherit it compile-scoped. -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>compute</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- P2-005: without ServicesResourceTransformer, META-INF/
                   services files from multiple shaded jars merge last-wins
                   and ServiceLoader discovery for the OTel metric reporter
                   factory can be silently dropped. Matches ingestion. -->
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- RocksDB 8.10 (frocksdbjni) on JDK 17 needs java.util AND java.nio opened
           (the parent pluginManagement default opens only java.nio for Arrow); the
           java.util.concurrent.atomic opens is the CHG-029 Kryo fix — live jobs that
           serialize BinaryRowData via Kryo fallback crash with InaccessibleObjectException
           on AtomicBoolean.value without it (candle-15s -> candle-late-drop-counter). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- P2-112: @{argLine} late-replacement placeholder first — an
               injected agent (JaCoCo -javaagent, …) prepends to the argLine
               property and must not be silently discarded. The add-opens
               flags live in the property (see <properties>), so they land
               via the placeholder and agents compose in front of them. -->
          <argLine>@{argLine} -Dlog4j2.configurationFile=${project.build.testOutputDirectory}/log4j2.xml</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
