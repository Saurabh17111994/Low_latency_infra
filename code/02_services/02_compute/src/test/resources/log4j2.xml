<?xml version="1.0" encoding="UTF-8"?>
<!-- P2-196: shutdownHook=disable KEPT (surefire hang protection) — durable
     capture comes from immediateFlush=true on the rolling file instead. -->
<Configuration status="WARN" shutdownHook="disable">
  <!--
    Test-scope log4j2 config for the compute module: makes MiniCluster /
    Flink / S3A logs visible in surefire output. Without a working slf4j
    provider, Flink falls back to NOP and checkpoint-write failures (e.g. the
    tracker-14 P4.2 R2 proof) are silent.
    SLF4J bridge: log4j-slf4j2-impl 2.25.4 (test scope) → Log4j2 2.25.4.
    P2-075: all TEMP DEBUG PROBE loggers (smoke-8/10/15, 2026-08-17) were
    removed — shaded-netty channel DEBUG flooded console+file and buried the
    checkpoint errors this config exists to surface. Re-diagnose by adding a
    logger back deliberately, or gate behind ${sys:flink.debug:-INFO}.
  -->
  <Properties>
    <!-- P2-076: %throwable suffix — the pattern omitting it dropped stack
         traces for exactly the checkpoint failures this file must surface. -->
    <Property name="CONSOLE_PATTERN">%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n%throwable</Property>
  </Properties>
  <Appenders>
    <!-- P2-197: SYSTEM_OUT — surefire's fork swallows SYSTEM_ERR, so console
         diagnostics were invisible in exactly the scenario the FILE appender
         was added for. -->
    <Console name="CONSOLE" target="SYSTEM_OUT">
      <PatternLayout pattern="${CONSOLE_PATTERN}"/>
    </Console>
    <!-- Tracker 14 P6.3 (2026-08-12): durable capture — surefire's fork
         swallows SYSTEM_ERR, so the stall-guard diagnostics were invisible.
         Written to the workspace mount (logs/tracker-14/) so container runs
         keep the Flink log after the container exits. -->
    <!-- P2-077: RollingFile — the plain File appender could grow without
         bound; 50MB x 5 (gz) caps disk. P2-196: immediateFlush keeps the
         diagnostics durable despite the disabled shutdown hook. -->
    <RollingFile name="FILE"
        fileName="${sys:test.log.dir:-target}/p63-flink.log"
        filePattern="${sys:test.log.dir:-target}/p63-flink-%i.log.gz"
        immediateFlush="true" append="false">
      <PatternLayout pattern="${CONSOLE_PATTERN}"/>
      <Policies>
        <SizeBasedTriggeringPolicy size="50 MB"/>
      </Policies>
      <DefaultRolloverStrategy max="5"/>
    </RollingFile>
  </Appenders>
  <Loggers>
    <!-- S3A is verbose at INFO (retries, region probes); keep at WARN so the
         P4.2 checkpoint proof surfaces real errors, not noise. -->
    <Logger name="org.apache.hadoop.fs.s3a" level="WARN"/>
    <Logger name="org.apache.flink" level="INFO"/>
    <Logger name="com.trading" level="INFO"/>
    <Root level="INFO">
      <AppenderRef ref="CONSOLE"/>
      <AppenderRef ref="FILE"/>
    </Root>
  </Loggers>
</Configuration>
