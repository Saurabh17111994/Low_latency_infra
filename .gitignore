# Ignore build output and secrets
target/
build/
dist/
*.class
*.jar
dependency-reduced-pom.xml
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# Secrets / local env
# P5-005: full .env coverage — root + any depth + dot-variants; .env.example
# stays visible (tracked; the ! keeps future untracked examples findable).
.env
.env.*
**/.env
**/.env.*
!**/.env.example
docker/.env
config/*.local.*
**/config/*.local.*
*.secret.*

# IDE / OS
.idea/
.vscode/
.DS_Store
code/01_platform/01_docker/.env
code/01_platform/01_docker/.env.bak-*

# Runtime logs / evidence artifacts (R-051: log4j2 JSON journals, dated gz
# rolls, and soak TSVs are generated per run and must never be committed —
# they contain host paths, endpoints, and account identifiers).
logs
# (plain `logs`, no slash: also matches the `logs -> <main project>/logs` symlink
# that Freebuff worktrees use for evidence — `logs/` alone leaves it untracked)
**/logs/*.json
**/logs/*.json.gz
**/logs/soak/
**/logs/*.log
**/logs/*.tsv
logs/ingestion.log
# P5-017: logs/glob scoped to generated evidence dirs — bare *.log/*.tsv
# swallowed intentional fixtures repo-wide. Re-allow if real testdata appears:
# !**/testdata/**/*.tsv
# !**/testdata/**/*.log

# Local agent/runtime junk — never pushed (2026-08-14):
# Agent-behavior symlinks at repo root, tool caches, sandbox state.
# P5-006: no /Cu* entry exists — name exact symlinks (root CLAUDE.md is
# anchored at /CLAUDE.md below) instead of a wildcard that swallows future
# legitimate Cu* sources.
.token-savior-cache.json
.pi/

# zcode hook tool-state (2026-08-18) — hook churn must never appear in git status.
# Patterns without a leading slash match at any depth (code/**, docs/**).
.mimosa/
.commandcode/

# Go build artifacts (2026-08-18) — arrow-bridge and the faketool binary are
# rebuilt by run-signal-chain-e2e.sh on every E2E run, so a committed binary
# goes stale the moment the runner rebuilds it (the tracked copies were noise).
# The sources (go-bridge/*.go, faketool/*.go) and golden testdata stay tracked.
# `**/` forms: a slash in the middle of a pattern anchors it to this file's own
# directory, so the artifact paths must be written depth-agnostically.
**/arrow-bridge
**/execution-arrow-bridge
**/faketool/faketool

# Eclipse/IDE metadata generated on this host.
# P5-024: dotfile names only — *.project matched any foo.project file.
.project
.classpath
**/.settings/

# Actively maintained signal-replay tracker (git-tracked; kept out of new-file scans).
docs/08_implementation/14-candle-log-kv-replay-safety_2.md

*.factorypath
# P5-019: root-local agent copies only; nested shared CLAUDE.md/TASK_CONTEXT.md
# stay tracked (gitignore never affects tracked files anyway).
/.freebuff/
/CLAUDE.md
/TASK_CONTEXT.md
code/01_platform/01_docker/secrets.env
# The real node inventory is generated per deploy; only the template is tracked.
code/01_platform/04_scripts/prod_vms.json
